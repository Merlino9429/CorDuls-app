# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase
# (Supabase → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=la-tua-anon-o-publishable-key
# Notifiche della web app: chiave pubblica VAPID (vedi README → Pubblicare la web app)
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
