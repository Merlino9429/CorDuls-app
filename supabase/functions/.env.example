# Segreti per le Edge Functions: `supabase secrets set --env-file supabase/functions/.env`
# NON committare il file .env reale.
SUMUP_API_KEY=sk_live_xxxxxxxxxxxxxxxx
SUMUP_MERCHANT_CODE=MXXXXXXX
# facoltativo: abilita "Enhanced security" sul servizio push di Expo
EXPO_ACCESS_TOKEN=
# schema dell'app per il ritorno dal pagamento (deve coincidere con "scheme" in app.json)
APP_SCHEME=cordulsapp
# Notifiche web (web app): genera le chiavi con `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@corduls.it
# indirizzo della web app: dopo il pagamento SumUp il cliente torna qui
APP_WEB_URL=https://corduls.it
